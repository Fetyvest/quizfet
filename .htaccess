<IfModule mod_rewrite.c>
    RewriteEngine On

    # =========================================================================
    # УПРАВЛЕНИЕ ДЛЯ АДМИНА (localhost)
    # Чтобы ОТКЛЮЧИТЬ перенаправление для себя и вернуть ПОЛНЫЙ ДОСТУП к папкам,
    # просто поставь знак # в самое начало следующей строки:
    # RewriteCond %{REMOTE_ADDR} !^(127\.0\.0\.1|::1)$
    # =========================================================================
    # Если строка выше активна — админа ТОЖЕ будет перенаправлять в public.
    # Если строка закомментирована — админ получает полную свободу в корне.


    # ОБЩЕЕ ПРАВИЛО ИЗОЛЯЦИИ В ПАПКУ PUBLIC
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>
